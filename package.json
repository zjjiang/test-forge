{
	"name": "test-forge",
	"version": "0.1.0",
	"description": "AI-native, scenario-driven testing platform for AI coding workflows",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"test-forge": "./bin/test-forge.js"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"tf": "tsx src/cli/index.ts"
	},
	"dependencies": {
		"@fastify/static": "10.1.8",
		"@midscene/web": "1.17.4",
		"better-sqlite3": "13.0.3",
		"commander": "15.0.0",
		"fastify": "5.12.7",
		"playwright": "1.64.1",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.0.5",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	}
}